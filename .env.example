PORT=5000
NODE_ENV=development

# Frontend dev server (Vite) — used for CORS during development
CLIENT_URL=http://localhost:5173

# MySQL connection — fill in your own values, never commit real secrets
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sport_center_management

# Long random string used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string
